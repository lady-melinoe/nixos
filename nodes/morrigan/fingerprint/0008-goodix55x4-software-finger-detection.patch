+#define FDT_CHANNELS 12
+#define FDT_READING_OFFSET 4
+#define FDT_DOWN_THRESHOLD_PERMILLE 40
+#define FDT_UP_THRESHOLD_PERMILLE 20
+#define FDT_BASELINE_TRACK_PERMILLE 15
+#define FDT_POLL_INTERVAL_MS 30
+#define FDT_LOG_MIN_PERMILLE 8
+
+static gboolean fdt_read_level(const guint8 *data, guint16 len, guint32 *level) {
+  if (!data || len < FDT_READING_OFFSET + FDT_CHANNELS * 2) {
+    return FALSE;
+  }
+  guint32 sum = 0;
+  for (int i = 0; i < FDT_CHANNELS; i++) {
+    sum += data[FDT_READING_OFFSET + i * 2] |
+           (data[FDT_READING_OFFSET + i * 2 + 1] << 8);
+  }
+  *level = sum;
+  return TRUE;
+}
+
+static guint32 fdt_deviation_permille(guint32 baseline, guint32 level) {
+  guint32 diff = level > baseline ? level - baseline : baseline - level;
+  return baseline ? (guint32)((guint64)diff * 1000 / baseline) : 0;
+}
+
+static void fdt_poll_cb(FpDevice *dev, guint8 *data, guint16 len,
+                        gpointer ssm, GError *err, guint threshold,
+                        gboolean wait_for_deviation) {
+  FpiDeviceGoodixTls55X4 *self = FPI_DEVICE_GOODIXTLS55X4(dev);
+  guint32 level;
+
+  if (err) {
+    fpi_ssm_mark_failed(ssm, err);
+    return;
+  }
+  if (!fdt_read_level(data, len, &level)) {
+    fpi_ssm_mark_failed(
+        ssm, fpi_device_error_new_msg(FP_DEVICE_ERROR_PROTO,
+                                      "Short finger detection reply"));
+    return;
+  }
+  if (!self->fdt_baseline) {
+    self->fdt_baseline = level;
+  }
+
+  guint32 dev_pm = fdt_deviation_permille(self->fdt_baseline, level);
+  gboolean deviated = dev_pm > threshold;
+  if (dev_pm >= FDT_LOG_MIN_PERMILLE || (wait_for_deviation ? deviated : !deviated)) {
+    g_print("FDT-POLL %s level=%u baseline=%u deviation=%u permille\n",
+            wait_for_deviation ? "down" : "up", level, self->fdt_baseline,
+            dev_pm);
+  }
+
+  if (wait_for_deviation ? deviated : !deviated) {
+    fpi_ssm_next_state(ssm);
+    return;
+  }
+  if (!deviated && dev_pm < FDT_BASELINE_TRACK_PERMILLE) {
+    self->fdt_baseline = (self->fdt_baseline * 15 + level) / 16;
+  }
+  fpi_ssm_jump_to_state_delayed(ssm, fpi_ssm_get_cur_state(ssm),
+                                FDT_POLL_INTERVAL_MS);
+}
+
+static void fdt_poll_down_cb(FpDevice *dev, guint8 *data, guint16 len,
+                             gpointer ssm, GError *err) {
+  fdt_poll_cb(dev, data, len, ssm, err, FDT_DOWN_THRESHOLD_PERMILLE, TRUE);
+}
+
+static void fdt_poll_up_cb(FpDevice *dev, guint8 *data, guint16 len,
+                           gpointer ssm, GError *err) {
+  fdt_poll_cb(dev, data, len, ssm, err, FDT_UP_THRESHOLD_PERMILLE, FALSE);
+}
